# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-key-here
SUPABASE_SERVICE_ROLE_KEY=service-role-key-here-never-expose

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
QR_ROTATION_SECONDS=10
QR_TOKEN_TTL_SECONDS=15
GEOFENCE_DEFAULT_RADIUS_M=100
CRON_SECRET=change-me
# 32+ random hex: enables admin view-as (impersonation). Generate: openssl rand -hex 32
IMPERSONATION_SECRET=change-me-to-random-hex

# Google OAuth (Sign in with Google)
# 1. Google Cloud Console → APIs & Services → OAuth 2.0 Client IDs → Web application
#    Authorized JavaScript origins:  http://localhost:3000  +  https://<your-vercel-domain>
#    Authorized redirect URIs:       http://localhost:54321/auth/v1/callback  +  https://<project-ref>.supabase.co/auth/v1/callback
# 2. Supabase Dashboard → Authentication → Providers → Google → enable with Client ID + Secret
#    Use gcloud (see GOOGLE_AUTH_SETUP.md) to create the client in project hudoor-nctu
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Passkeys / WebAuthn
# NEXT_PUBLIC_AUTH_ORIGIN must be the exact origin users open (localhost or your Vercel domain).
# Used as WebAuthn relying-party id/origin so passkeys are scoped to this domain only.
NEXT_PUBLIC_AUTH_ORIGIN=http://localhost:3000
