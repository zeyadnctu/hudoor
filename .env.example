# Hudoor — environment reference (copy to .env.local / set in Vercel)

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable anon key>
SUPABASE_SERVICE_ROLE_KEY=<service_role key, SERVER ONLY>

# Optional fast-path: legacy JWT secret for local verification of session
# tokens signed HS256. NOT needed on projects using asymmetric (ES256) JWT
# signing keys — the app verifies those from the public JWKS automatically.
SUPABASE_JWT_SECRET=<legacy JWT secret>

# Admin view-as JWT signing secret (impersonation preview). 32+ random hex:
# openssl rand -hex 32
IMPERSONATION_SECRET=change-me-to-random-hex

# Bearer secret protecting /api/cron/sessions (Vercel Cron / external cron)
CRON_SECRET=change-me

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (Sign in with Google)
# 1. Google Cloud Console → APIs & Services → OAuth 2.0 Client IDs → Web application
#    Authorized JavaScript origins:  http://localhost:3000  +  https://<your-vercel-domain>
#    Authorized redirect URIs:       https://<project-ref>.supabase.co/auth/v1/callback
# 2. Supabase Dashboard → Authentication → Providers → Google → enable with Client ID + Secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Passkeys / WebAuthn
# NEXT_PUBLIC_AUTH_ORIGIN must be the exact origin users open (localhost or your Vercel domain).
# Used as WebAuthn relying-party id/origin so passkeys are scoped to this domain only.
NEXT_PUBLIC_AUTH_ORIGIN=http://localhost:3000

# Optional scan/tuning overrides (else driven by admin settings)
QR_ROTATION_SECONDS=10
QR_TOKEN_TTL_SECONDS=15
GEOFENCE_DEFAULT_RADIUS_M=100
